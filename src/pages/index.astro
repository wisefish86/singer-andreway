---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';

const phoneDisplay = '+7 918 114-26-93';
const phoneLink = 'tel:+79181142693';
const telegramWeb = 'https://t.me/shevtsov_andrey';
const telegramApp = 'tg://resolve?domain=shevtsov_andrey';
const whatsapp = 'https://wa.me/79181142693';
const instagram = 'https://www.instagram.com/andrey_spoet/';
const instagramDirect = 'https://ig.me/m/andrey_spoet';
const telegramChannelWeb = 'https://t.me/andrey_spoet';
const telegramChannelApp = 'tg://resolve?domain=andrey_spoet';
const vk = 'https://vk.me/andrey_spoet';
const max = 'https://max.ru/u/f9LHodD0cOJuO0xwTsWmcH790HmZrPc21wP-BOoIgfgdGy5HKaHMK3ejGSQ';

const seoTitle = 'Певец на мероприятие в Краснодаре — Андрей Шевцов';
const seoDescription = 'Живой вокал на свадьбы, корпоративы, юбилеи, рестораны и частные мероприятия в Краснодаре и Краснодарском крае. Репертуар 300+ песен.';
const canonical = 'https://singer.andreway.ru/';
const repertoireUrl = 'https://magazinot.ru/files/andrey-spoet/index.html';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#06101a" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="application-name" content="ANDREY-SPOET" />
  <meta name="apple-mobile-web-app-title" content="ANDREY-SPOET" />
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ru_RU" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"Person",
    "name":"Андрей Шевцов",
    "jobTitle":"Певец",
    "url":canonical,
    "telephone":"+79181142693",
    "areaServed":["Краснодар","Краснодарский край"],
    "sameAs":[telegramWeb,instagram,vk,max]
  })}></script>
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="#top">ANDREY-SPOET</a>
      <nav class="nav" aria-label="Навигация">
        <a href="#repertoire">Репертуар</a>
        <a href="#events">Афиша</a>
        <a href="#video">Видео</a>
        <a href="#contact">Контакты</a>
      </nav>
      <div class="social-mini">
        <a class="icon-btn" href={telegramApp} aria-label="Telegram" target="_blank" rel="noreferrer"><BrandIcon name="telegram" size={19} /></a>
        <a class="icon-btn" href={instagram} aria-label="Instagram" target="_blank" rel="noreferrer"><BrandIcon name="instagram" size={19} /></a>
      </div>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-content">
      <div class="kicker kicker-desktop">Живой вокал • Краснодар • Краснодарский край</div>
      <div class="kicker kicker-mobile"><span>Живое выступление</span><span>Краснодарский край</span></div>
      <h1><span>Андрей</span><span class="hero-name-last">Шевцов</span></h1>
      <div class="hero-role">певец</div>
      <p class="hero-copy">Современные и вечные хиты в живом исполнении. Рестораны, частные события, свадьбы и корпоративы.</p>
      <div class="chips">
        <span class="chip">300+ песен</span>
        <span class="chip">150+ зарубежных хитов</span>
        <span class="chip">своё оборудование</span>
      </div>
      <div class="hero-actions">
        <a class="btn primary full" href="#contact">Заказать выступление →</a>
        <a class="btn" href="#video"><Icon name="play" size={18} /> Смотреть видео</a>
        <a class="btn" href="/andrey-shevtsov.vcf" type="text/vcard"><Icon name="contact" size={18} /> Сохранить контакт</a>
      </div>
    </div>
  </section>

  <section class="quick">
    <div class="container quick-grid">
      <a class="quick-card" href="#video"><div class="quick-icon"><Icon name="play" size={28} /></div><div class="quick-title">Видео</div><div class="quick-sub">живые выступления</div></a>
      <a class="quick-card" href="#repertoire"><div class="quick-icon"><Icon name="music" size={28} /></div><div class="quick-title">Репертуар</div><div class="quick-sub">300+ песен</div></a>
      <a class="quick-card" href="#photos"><div class="quick-icon"><Icon name="image" size={28} /></div><div class="quick-title">Фото</div><div class="quick-sub">с выступлений</div></a>
      <a class="quick-card" href="#events"><div class="quick-icon"><Icon name="calendar" size={28} /></div><div class="quick-title">Афиша</div><div class="quick-sub">ближайшие даты</div></a>
      <a class="quick-card" href="#live"><div class="quick-icon"><Icon name="mic" size={28} /></div><div class="quick-title">Во время выступления</div><div class="quick-sub">песня, сообщение, благодарность</div></a>
      <a class="quick-card" href="#contact"><div class="quick-icon"><Icon name="smartphone" size={28} /></div><div class="quick-title">Контакты</div><div class="quick-sub">мессенджеры, звонок, соцсети</div></a>
    </div>
  </section>

  <main>
    <section class="section" id="events">
      <div class="container">
        <div class="section-head">
          <div><h2>Ближайшее выступление</h2><p class="lead">Открытые выступления и события</p></div>
          <a class="link" href="#">Вся афиша →</a>
        </div>
        <article class="event-card">
          <div class="event-media"></div>
          <div class="event-body">
            <div class="event-date event-date-soon"><strong>Скоро</strong></div>
            <div class="event-title">Ближайшее открытое выступление</div>
            <div class="event-place">Дата и площадка появятся здесь</div>
            <div class="event-actions">
              <a class="btn primary" href="#">Подробнее →</a>
              <a class="btn" href="#">＋ В календарь</a>
              <a class="btn" href={telegramApp}>◉ Напомнить в Telegram</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section" id="video">
      <div class="container">
        <div class="section-head">
          <div><h2>Видео</h2><p class="lead">Энергия живых выступлений</p></div>
          <a class="link" href="#">Все видео →</a>
        </div>
        <div class="media-row">
          <article class="video-card"><div class="video-thumb"></div><div class="video-info"><div class="video-title">Лучшие моменты</div><div class="video-sub">живое выступление</div></div></article>
          <article class="video-card"><div class="video-thumb"></div><div class="video-info"><div class="video-title">Поп-хиты</div><div class="video-sub">динамичный сет</div></div></article>
          <article class="video-card"><div class="video-thumb"></div><div class="video-info"><div class="video-title">Вечные хиты</div><div class="video-sub">для особых событий</div></div></article>
          <article class="video-card"><div class="video-thumb"></div><div class="video-info"><div class="video-title">Атмосфера вечера</div><div class="video-sub">ресторанный формат</div></div></article>
        </div>
      </div>
    </section>

    <section class="section" id="repertoire">
      <div class="container">
        <div class="section-head">
          <div><h2>Репертуар</h2><p class="lead">От лёгкой поп-музыки до рока — под аудиторию и формат</p></div>
          <a class="link" href="#">Весь репертуар →</a>
        </div>
        <div class="rep-grid">
          <a class="rep-card" href="#"><strong>Поп-хиты</strong><span>узнаваемое и лёгкое</span></a>
          <a class="rep-card" href="#"><strong>Русские хиты</strong><span>для общего подпевания</span></a>
          <a class="rep-card" href="#"><strong>Зарубежные</strong><span>EN repertoire</span></a>
          <a class="rep-card" href="#"><strong>Романтические</strong><span>для красивых моментов</span></a>
          <a class="rep-card" href="#"><strong>Танцевальные</strong><span>для финального драйва</span></a>
        </div>
      </div>
    </section>

    <section class="section" id="live">
      <div class="container">
        <div class="section-head">
          <div><h2>Здесь и сейчас</h2><p class="lead">Во время выступления можно</p></div>
        </div>
        <div class="live-actions">
          <button class="action-wide js-contact-sheet" type="button"
            data-title="Заказать песню"
            data-copy="Можно сначала выбрать песню из репертуара или написать в удобный мессенджер."
            data-repertoire="true">
            <div class="action-icon"><Icon name="music" size={24} /></div><div class="action-copy"><strong>Заказать песню</strong><small>выбрать и отправить</small></div><Icon name="arrow" size={20} />
          </button>
          <button class="action-wide js-contact-sheet" type="button"
            data-title="Сказать пару слов"
            data-copy="Выберите удобный мессенджер и отправьте текст, голосовое или видео."
            data-template="Хочу передать пару слов:">
            <div class="action-icon"><Icon name="message" size={24} /></div><div class="action-copy"><strong>Сказать пару слов</strong><small>текстом, голосом или видео</small></div><Icon name="arrow" size={20} />
          </button>
          <a class="action-wide tip-action" href="#"><div class="action-icon"><Icon name="heart" size={24} /></div><div class="action-copy"><strong>Поблагодарить</strong><small>чаевыми / переводом</small></div><Icon name="arrow" size={20} /></a>
        </div>
        <div class="after-live">
          <div class="after-live-label">После выступления</div>
          <div class="after-live-grid">
            <button class="after-action js-contact-sheet" type="button"
              data-title="Поделиться видео"
              data-copy="Выберите удобный мессенджер. Видео прикрепите уже в открывшемся чате."
              data-template="Здравствуйте, Андрей! Делюсь видео с Вашего выступления ❤️">
              <Icon name="share" size={20} /><span>Поделиться видео</span>
            </button>
            <button class="after-action js-contact-sheet" type="button"
              data-title="Оставить отзыв"
              data-copy="Спасибо! Выберите, куда удобнее отправить отзыв."
              data-template="Здравствуйте, Андрей! Хочу оставить отзыв о выступлении:">
              <Icon name="star" size={20} /><span>Оставить отзыв</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="photos">
      <div class="container">
        <div class="section-head">
          <div><h2>Фото</h2><p class="lead">Сцена, публика, живые моменты</p></div>
          <a class="link" href="#">Все фото →</a>
        </div>
        <div class="media-row">
          <article class="video-card"><div class="video-thumb"></div></article>
          <article class="video-card"><div class="video-thumb"></div></article>
          <article class="video-card"><div class="video-thumb"></div></article>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container">
        <div class="contact">
          <div class="contact-media"></div>
          <div class="contact-body">
            <h2 class="contact-title">Давайте обсудим ваш вечер</h2>
            <p class="contact-copy">Оставьте заявку или свяжитесь удобным способом.</p><div class="trust-line">Работа по договору <span>•</span> своё оборудование <span>•</span> прозрачные условия</div>
            <div class="contact-actions">
              <a class="contact-phone" href={phoneLink}><Icon name="smartphone" size={22} /><span>Позвонить · {phoneDisplay}</span></a>

              <div class="contact-write">
                <div class="contact-group-label">Написать</div>
                <div class="contact-socials" aria-label="Написать в мессенджере или соцсети">
                  <a href={telegramApp}><BrandIcon name="telegram" size={22} /><span>Telegram</span></a>
                  <a href={whatsapp} target="_blank" rel="noreferrer"><BrandIcon name="whatsapp" size={22} /><span>WhatsApp</span></a>
                  <a href={max} target="_blank" rel="noreferrer"><BrandIcon name="max" size={22} /><span>MAX</span></a>
                  <a href={vk} target="_blank" rel="noreferrer"><BrandIcon name="vk" size={22} /><span>ВКонтакте</span></a>
                  <a href={instagramDirect} target="_blank" rel="noreferrer"><BrandIcon name="instagram" size={22} /><span>Instagram</span></a>
                </div>
              </div>

              <a class="contact-save" href="/andrey-shevtsov.vcf" type="text/vcard"><Icon name="contact" size={22} /><span>Сохранить контакт</span></a>
            </div>

            <div class="stay-connected">
              <div class="stay-title">Останемся на связи</div>
              <div class="stay-copy">Афиши, новые видео и новости — подпишитесь там, где удобнее.</div>
              <div class="stay-links">
                <a href={telegramChannelApp}><BrandIcon name="telegram" size={22} /><span><strong>Telegram</strong><small>подписаться на канал</small></span></a>
                <a href={instagram} target="_blank" rel="noreferrer"><BrandIcon name="instagram" size={22} /><span><strong>Instagram</strong><small>подписаться</small></span></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <dialog class="contact-sheet" id="contact-sheet">
    <div class="sheet-handle" aria-hidden="true"></div>
    <div class="sheet-head">
      <div>
        <h3 id="sheet-title">Написать Андрею</h3>
        <p id="sheet-copy">Выберите удобный способ связи.</p>
      </div>
      <button class="sheet-close" type="button" aria-label="Закрыть"><Icon name="close" size={20} /></button>
    </div>
    <a class="sheet-repertoire" id="sheet-repertoire" href={repertoireUrl} target="_blank" rel="noreferrer">
      <Icon name="music" size={20} /><span><strong>Выбрать песню из репертуара</strong><small>откроется список песен</small></span><Icon name="arrow" size={18} />
    </a>
    <div class="sheet-messengers">
      <a data-messenger="telegram" href={telegramApp}><BrandIcon name="telegram" size={23} /><span>Telegram</span></a>
      <a data-messenger="whatsapp" href={whatsapp} target="_blank" rel="noreferrer"><BrandIcon name="whatsapp" size={23} /><span>WhatsApp</span></a>
      <a data-messenger="max" href={max} target="_blank" rel="noreferrer"><BrandIcon name="max" size={23} /><span>MAX</span></a>
      <a data-messenger="vk" href={vk} target="_blank" rel="noreferrer"><BrandIcon name="vk" size={23} /><span>ВКонтакте</span></a>
    </div>
  </dialog>

  <footer class="footer">
    <div class="container">© {new Date().getFullYear()} Андрей Шевцов · singer.andreway.ru</div>
  </footer>
  <script is:inline data-contact-sheet-script>
    const sheet = document.getElementById('contact-sheet');
    const sheetTitle = document.getElementById('sheet-title');
    const sheetCopy = document.getElementById('sheet-copy');
    const sheetRepertoire = document.getElementById('sheet-repertoire');
    let sheetTemplate = '';

    document.querySelectorAll('.js-contact-sheet').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        sheetTitle.textContent = trigger.dataset.title || 'Написать Андрею';
        sheetCopy.textContent = trigger.dataset.copy || 'Выберите удобный способ связи.';
        sheetTemplate = decodeURIComponent(trigger.dataset.template || '');
        sheetRepertoire.hidden = trigger.dataset.repertoire !== 'true';
        sheet.showModal();
      });
    });

    document.querySelector('.sheet-close')?.addEventListener('click', () => sheet.close());
    sheet?.addEventListener('click', (event) => {
      if (event.target === sheet) sheet.close();
    });

    document.querySelectorAll('[data-messenger]').forEach((link) => {
      link.addEventListener('click', async (event) => {
        const messenger = link.dataset.messenger;
        if (messenger === 'whatsapp' && sheetTemplate) {
          link.href = 'https://wa.me/79181142693?text=' + encodeURIComponent(sheetTemplate);
        }
      });
    });
  </script>

</body>
</html>