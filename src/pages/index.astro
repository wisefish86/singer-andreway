  <script is:inline data-guest-evening-hours>
    (() => {
      const banner = document.getElementById('guest-evening-banner');
      if (!banner) return;
      // Visitors use the artist's Krasnodar/Moscow clock, not device timezone.
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Moscow', weekday: 'short', hour: '2-digit', hourCycle: 'h23'
      });
      const api = 'https://script.google.com/macros/s/AKfycbzCtHUBRaC3c_Tovx6We58tVElMRn1w6FUkcLCdNZAVhDyLnVj8hut-_gKTXgov086tlg/exec';
      const preview = new URLSearchParams(location.search).get('guest-preview') === '1';
      let windows = [];
      let lastFetch = 0;
      function updateGuestBanner() {
        const now = Date.now();
        const parts = Object.fromEntries(formatter.formatToParts(new Date(now))
          .filter(part => part.type !== 'literal').map(part => [part.type, part.value]));
        const regularWeekend = (parts.weekday === 'Fri' || parts.weekday === 'Sat')
          && Number(parts.hour) >= 20;
        const calendarShow = windows.some(show => now >= Date.parse(show.start) && now < Date.parse(show.end));
        banner.hidden = !(preview || regularWeekend || calendarShow);
      }
      // The endpoint returns only times for !В performances, not private notes.
      window.singerGuestModeLoaded = data => {
        if (!data || !Array.isArray(data.windows)) return;
        windows = data.windows.filter(w => Number.isFinite(Date.parse(w.start))
          && Number.isFinite(Date.parse(w.end)));
        updateGuestBanner();
      };
      function refreshCalendar() {
        if (Date.now() - lastFetch < 240000) return;
        lastFetch = Date.now();
        const script = document.createElement('script');
        script.async = true;
        script.src = api + '?kind=guest-mode&callback=singerGuestModeLoaded&v='
          + Math.floor(Date.now() / 300000);
        script.onload = () => script.remove();
        script.onerror = () => script.remove();
        document.head.append(script);
      }
      updateGuestBanner();
      refreshCalendar();
      window.setInterval(() => { updateGuestBanner(); refreshCalendar(); }, 60000);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) { updateGuestBanner(); refreshCalendar(); }
      });
    })();
  </script>

  <script is:inline data-modal-scroll-lock>
    (() => {
      const dialogs = [...document.querySelectorAll('dialog')];
      let savedY = null;
      const sync = () => {
        const opened = dialogs.some(dialog => dialog.open);
        if (opened && savedY === null) {
          savedY = window.scrollY;
          document.body.style.position = 'fixed';
          document.body.style.top = '-' + savedY + 'px';
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
        } else if (!opened && savedY !== null) {
          const y = savedY;
          savedY = null;
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          window.scrollTo(0, y);
        }
      };
      dialogs.forEach(dialog => {
        dialog.addEventListener('toggle', sync);
        dialog.addEventListener('close', sync);
      });
    })();
  </script>
