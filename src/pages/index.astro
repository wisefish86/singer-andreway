---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import SiteFavicons from '../components/SiteFavicons.astro';
import ContactSheet from '../components/ContactSheet.astro';
import { readFileSync } from 'node:fs';
const mediaSnapshot = JSON.parse(readFileSync('public/media-catalog.json', 'utf8'));
const afishaSnapshot = JSON.parse(readFileSync('public/data/afisha.public.json', 'utf8'));
import { telegramWeb, telegramApp, whatsapp, contactMessages, directChatLinks } from '../config/contact-links';

const phoneDisplay = '+7 918 114-26-93';
const phoneLink = 'tel:+79181142693';
const eventChat = directChatLinks(contactMessages.event);
const instagram = 'https://www.instagram.com/andrey_spoet/';
const telegramChannelWeb = 'https://t.me/andrey_spoet';
const reminderBotUrl = 'tg://resolve?domain=andrey_spoet_bot&start=reminders';
const reminderBotWeb = 'https://t.me/andrey_spoet_bot?start=reminders';
const telegramChannelApp = 'tg://resolve?domain=andrey_spoet';
const max = 'https://max.ru/u/f9LHodD0cOJuO0xwTsWmcH790HmZrPc21wP-BOoIgfgdGy5HKaHMK3ejGSQ';

const seoTitle = 'Певец на мероприятие в Краснодаре — Андрей Шевцов';
const seoDescription = 'Живой вокал на свадьбы, корпоративы, юбилеи, рестораны и частные мероприятия в Краснодаре и Краснодарском крае. Репертуар 300+ песен.';
const canonical = 'https://singer.andreway.ru/';
const repertoireUrl = '/podborka/';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SiteFavicons />
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  <link rel="canonical" href={canonical} />
  <link rel="prefetch" href="/afisha/" />
  <link rel="prefetch" href="/all-photos/" />
  <link rel="prefetch" href="/all-videos/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ru_RU" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"Person",
    "name":"Андрей Шевцов",
    "jobTitle":"Певец",
    "url":canonical,
    "telephone":"+79181142693",
    "areaServed":["Краснодар","Краснодарский край"],
    "sameAs":[telegramWeb,telegramChannelWeb,instagram,max]
  })}></script>

  <style is:global>
    .guest-evening-banner[hidden]{display:none!important}
    .guest-evening-banner{position:relative;z-index:5;background:linear-gradient(110deg,#152b3e,#172333);border-bottom:1px solid rgba(231,190,110,.48);padding:12px 0}
    .guest-evening-inner{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
    .guest-evening-label{display:flex;align-items:center;gap:8px;color:#f6dbab;font-weight:700;font-size:.94rem;line-height:1.3}
    .guest-evening-label::before{content:"";width:8px;height:8px;flex:none;background:#e9bd6e;border-radius:50%;box-shadow:0 0 0 4px rgba(233,189,110,.12)}
    .guest-evening-link{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 18px;border-radius:12px;background:linear-gradient(135deg,#f3d591,#d5a454);color:#18202a;font-weight:800;text-decoration:none;text-align:center;min-height:44px}
    .guest-evening-link:hover{filter:brightness(1.06)}
    .guest-evening-link:focus-visible{outline:3px solid #fff;outline-offset:3px}
    /* #live uses the shared .section[id] anchor offset in global.css. */
    @media(max-width:600px){.guest-evening-inner{gap:9px}.guest-evening-label{font-size:.86rem;text-align:center}.guest-evening-link{width:100%}}
  .live-actions > [hidden]{display:none!important}.home-reviews[hidden]{display:none!important}.home-reviews-carousel{position:relative}.home-reviews-controls{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;pointer-events:none;z-index:2;padding:0 8px}.home-reviews-controls[hidden]{display:none!important}.home-reviews-controls button{pointer-events:auto;display:grid;place-items:center;border:1px solid rgba(255,255,255,.36);border-radius:50%;background:rgba(8,20,32,.88);color:var(--text);width:43px;height:43px;box-shadow:0 4px 16px #0007;cursor:pointer;transition:opacity .2s}.home-reviews-controls button:disabled{opacity:0;pointer-events:none}@media(hover:hover){.home-reviews-controls button:not(:focus-visible){opacity:0}.home-reviews-carousel:hover .home-reviews-controls button:not(:disabled){opacity:1}}.home-reviews-track{display:flex;gap:16px;overflow:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding:4px 0 16px}.home-review{box-sizing:border-box;flex:0 0 min(375px,calc(100% - 16px));scroll-snap-align:start;padding:23px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#152737,#0e1d29)}.home-review-head{display:flex;align-items:center;gap:12px;margin-bottom:18px}.home-review-head img{height:54px;width:54px;border-radius:50%;object-fit:cover}.home-review-head strong{display:block}.home-review-head small{display:block;color:var(--muted);font-size:.79rem;margin-top:4px}.home-review p{font-size:.98rem;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}@media(min-width:800px){.home-review{flex-basis:calc((100% - 32px)/3)}}
</style>
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="#top">ANDREY-SPOET</a>
      <nav class="nav" aria-label="Навигация">
        <a href="#repertoire">Репертуар</a>
        <a href="#events">Афиша</a>
        <a href="#reviews">Отзывы</a>
        <a href="#video">Видео</a>
        <a href="#contact">Контакты</a>
      </nav>
      <div class="social-mini">
        <a class="icon-btn" href={telegramChannelApp} data-social-destination data-social-web={telegramChannelWeb} data-social-platform="telegram" data-social-name="Telegram-канал с афишей" aria-label="Telegram-канал"><BrandIcon name="telegram" size={19} /></a>
      </div>
    </div>
  </header>


  <!-- This banner is visible only on Fri/Sat 20:00–00:00, Europe/Moscow time. -->
  <aside class="guest-evening-banner" id="guest-evening-banner" aria-label="Для гостей выступления" hidden>
    <div class="container guest-evening-inner">
      <span class="guest-evening-label">Вы сегодня на моём выступлении?</span>
      <a class="guest-evening-link" href="#live">Для гостей вечера ↓</a>
    </div>
  </aside>

  <section class="hero" id="top">
    <div class="container hero-content">
      <div class="kicker kicker-desktop">Живой вокал • Краснодар • Краснодарский край</div>
      <div class="kicker kicker-mobile"><span>Живой вокал</span><span>Краснодар • край</span></div>
      <h1><span>Андрей</span><span class="hero-name-last">Шевцов</span></h1>
      <div class="hero-role">певец</div>
      <p class="hero-copy">Современные и вечные хиты в живом исполнении. Рестораны, частные события, свадьбы и корпоративы.</p>
      <div class="chips">
        <span class="chip">300+ песен</span>
        <span class="chip">150+ зарубежных хитов</span>
        <span class="chip">своё оборудование</span>
      </div>
      <div class="hero-actions" aria-label="Главные действия">
        <a class="btn primary hero-booking" href="#contact">Заказать выступление →</a>
        <a class="btn hero-subscribe" href={reminderBotUrl} data-social-destination data-social-platform="telegram" data-social-web={reminderBotWeb} data-social-name="напоминания о выступлениях">
          <BrandIcon name="telegram" size={22} />
          <span><strong>Напоминания в Telegram</strong><small>О ближайших выступлениях</small></span>
        </a>
        <div class="hero-more-actions">
          <a class="btn" href="/andrey-shevtsov.vcf" type="text/vcard"><Icon name="contact" size={18} /> Сохранить контакт</a>
          <a class="btn" href="#video"><Icon name="play" size={18} /> Смотреть видео</a>
        </div>
        <a class="hero-channel-link" href={telegramChannelApp} data-social-destination data-social-platform="telegram" data-social-web={telegramChannelWeb} data-social-name="Telegram-канал с афишей"><BrandIcon name="telegram" size={17} /> Афиша и новости в Telegram-канале →</a>
      </div>
    </div>
  </section>

  <section class="quick">
    <div class="container quick-grid">
      <a class="quick-card" href="#repertoire"><div class="quick-icon"><Icon name="music" size={28} /></div><div class="quick-title">Репертуар</div><div class="quick-sub">300+ песен</div></a>
      <a class="quick-card" href="#photos"><div class="quick-icon"><Icon name="image" size={28} /></div><div class="quick-title">Фото</div><div class="quick-sub">с выступлений</div></a>
      <a class="quick-card" href="#events"><div class="quick-icon"><Icon name="calendar" size={28} /></div><div class="quick-title">Афиша</div><div class="quick-sub">ближайшие даты</div></a>
      <a class="quick-card" href="#live"><div class="quick-icon"><Icon name="mic" size={28} /></div><div class="quick-title">Во время выступления</div><div class="quick-sub">песня, сообщение, благодарность</div></a>
      <a class="quick-card" href="#reviews"><div class="quick-icon"><Icon name="message" size={28} /></div><div class="quick-title">Отзывы</div><div class="quick-sub">впечатления гостей</div></a>
    </div>
  </section>

  <main>
    <section class="section" id="events">
      <div class="container">
        <div class="section-head">
          <div><h2>Ближайшее выступление</h2><p class="lead">Открытые выступления и события</p></div>
          <a class="link" href="/afisha/">Вся афиша →</a>
        </div>
        <article class="event-card">
          <div class="event-media" id="next-show-media"></div>
          <div class="event-body">
            <div class="event-date event-date-soon" id="next-show-date"><strong>Скоро</strong></div>
            <div class="event-title" id="next-show-title">Ближайшее открытое выступление</div>
            <div class="event-place">Дата и площадка появятся здесь</div>
            <div class="event-actions">
              <a id="event-google-calendar" class="btn primary event-google-calendar" href="https://calendar.google.com/calendar/render?action=TEMPLATE" target="_blank" rel="noopener noreferrer"><Icon name="calendar" size={19} /><span>Добавить в Google Календарь</span></a>
              <a class="btn event-telegram-reminder" href={reminderBotUrl} data-social-destination data-social-web={reminderBotWeb} data-social-platform="telegram" data-social-name="напоминания в Telegram"><Icon name="bell" size={19} /><span>Напоминание в Telegram</span></a>
              <a id="event-venue-details" class="btn event-venue-details" href="#" target="_blank" rel="noopener noreferrer" hidden><span>Подробнее о заведении</span><Icon name="arrow" size={19} /></a>
            </div>
          </div>
        </article>
      </div>
    </section>


    <section class="section" id="video">
      <div class="container">
        <div class="section-head">
          <div><h2>Видео выступлений</h2><p class="lead">Живой вокал и атмосфера вечера</p></div>
          <a class="link" href="/all-videos/">Все видео →</a>
        </div>
        <div class="showcase-grid showcase-home" data-media-gallery="videos"></div>
      </div>
    </section>

    <section class="section" id="repertoire">
      <div class="container">
        <div class="section-head">
          <div><h2>Репертуар</h2><p class="lead">От лёгкой поп-музыки до рока — под аудиторию и формат</p></div>
          <a class="link" href={repertoireUrl}>Весь репертуар →</a>
        </div>
        <div class="rep-grid">
          <a class="rep-card" href="/podborka/?field=language&amp;tag=%D0%AF-%D1%80%D1%83%D1%81"><strong>Русские песни</strong></a>
          <a class="rep-card" href="/podborka/?field=language&amp;tag=%D0%AF-%D0%B0%D0%BD%D0%B3%D0%BB%2C%D0%AF-%D0%B8%D0%BD"><strong>Иностранные песни</strong></a>
          <a class="rep-card" href="/podborka/?field=mood&amp;tag=%D0%BD-%D0%A0%D0%BE%D0%BC%D0%B0%D0%BD%D1%82%D0%B8%D0%BA%D0%B0"><strong>Романтика</strong></a>
          <a class="rep-card" href="/podborka/?preset=dance"><strong>Танцевальные</strong></a>
          <a class="rep-card" href="/podborka/?field=situations&amp;tag=%D1%81-%D0%94%D0%BB%D1%8F%D0%96%D0%B5%D0%BD"><strong>Для женщины</strong></a>
        </div>
      </div>
    </section>

    <section class="section" id="live">
      <div class="container">
        <div class="section-head">
          <div><h2>Для гостей</h2><p class="lead">Закажите песню, передайте пожелание или поделитесь моментом выступления</p></div>
        </div>
        <div class="live-actions">
          <a class="action-wide" href="/vote/" id="live-voting-link" hidden>
            <div class="action-icon"><Icon name="flame" size={24} /></div><div class="action-copy"><strong>Выбрать финальные песни</strong><small id="live-voting-status">Посмотреть подборку · голосование во время выступления</small></div><Icon name="arrow" size={20} />
          </a>
          <button class="action-wide js-contact-sheet" type="button"
            data-title="Заказать песню"
            data-copy="Можно сначала выбрать песню из репертуара или написать в удобный мессенджер."
            data-repertoire="true"
            data-template={contactMessages.song}>
            <div class="action-icon"><Icon name="music" size={24} /></div><div class="action-copy"><strong>Заказать песню</strong><small>выбрать и отправить</small></div><Icon name="arrow" size={20} />
          </button>
          <button class="action-wide js-contact-sheet" id="guest-video-action" type="button" data-send-video="true"
            data-title="Отправить видео"
            data-copy="Сняли моё выступление? Пришлите видео — в благодарность исполню для вас одну песню на выбор из моего репертуара во время сегодняшнего вечера, по согласованию и если позволит программа."
            data-template={contactMessages.video}>
            <div class="action-icon"><Icon name="share" size={24} /></div><div class="action-copy"><strong>Сняли моё выступление?</strong><small>Пришлите видео — спою для вас песню в благодарность!</small></div><Icon name="arrow" size={20} />
          </button>
          <button class="action-wide js-contact-sheet" type="button"
            data-title="Сказать пару слов"
            data-copy="Выберите удобный мессенджер и отправьте текст, голосовое или видео."
            data-template={contactMessages.feedback}>
            <div class="action-icon"><Icon name="message" size={24} /></div><div class="action-copy"><strong>Сказать пару слов</strong><small>текстом, голосом или видео</small></div><Icon name="arrow" size={20} />
          </button>
          <a class="action-wide tip-action" href="https://www.sberbank.ru/ru/choise_bank?requisiteNumber=79181142693&amp;bankCode=100000000111" target="_blank" rel="noopener noreferrer"><div class="action-icon"><Icon name="heart" size={24} /></div><div class="action-copy"><strong>Поблагодарить</strong><small>чаевыми / переводом</small></div><Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </section>


    <section class="section" id="photos">
      <div class="container">
        <div class="section-head">
          <div><h2>Фото</h2><p class="lead">Сцена, публика, живые моменты</p></div>
          <a class="link" href="/all-photos/">Все фото →</a>
        </div>
        <div class="showcase-grid showcase-home" data-media-gallery="photos"></div>
      </div>
    </section>

    <section class="section home-reviews" id="reviews" aria-label="Отзывы гостей" hidden>
<div class="container"><div class="section-head"><div><h2>Отзывы о выступлениях</h2><p class="lead">Что говорят гости</p></div><a class="link" href="/reviews/">Все отзывы →</a></div>
<div class="home-reviews-carousel"><div class="home-reviews-controls" id="reviews-controls" hidden><button id="reviews-back" type="button" aria-label="Предыдущие отзывы">←</button><button id="reviews-forward" type="button" aria-label="Следующие отзывы">→</button></div>
 <div class="home-reviews-track" id="reviews-track" tabindex="0" aria-label="Отзывы гостей"></div></div></div></section>
<section class="section" id="contact">
      <div class="container">
        <div class="contact">
          <div class="contact-media"></div>
          <div class="contact-body">
            <h2 class="contact-title">Обсудим ваше мероприятие</h2>
            <p class="contact-copy">Оставьте заявку или свяжитесь удобным способом.</p><div class="trust-line">Работа по договору <span>•</span> своё оборудование <span>•</span> прозрачные условия</div>
            <div class="contact-actions">
              <a class="contact-phone" href={phoneLink}><Icon name="smartphone" size={22} /><span>Позвонить · {phoneDisplay}</span></a>

              <div class="contact-write">
                <div class="contact-group-label">Написать</div>
                <div class="contact-socials" aria-label="Написать в мессенджере">
                  <a href={eventChat.telegramApp} data-social-destination data-social-web={eventChat.telegramWeb} data-social-platform="telegram" data-social-name="написать в Telegram"><BrandIcon name="telegram" size={22} /><span>Telegram</span></a>
                  <a href={eventChat.whatsapp} data-social-destination data-social-web={eventChat.whatsapp} data-social-platform="whatsapp" data-social-name="написать в WhatsApp"><BrandIcon name="whatsapp" size={22} /><span>WhatsApp</span></a>
                  <a href={max} data-social-destination data-social-web={max} data-social-platform="max" data-social-name="написать в MAX" aria-label="Написать в MAX"><BrandIcon name="max" size={22} /><span>MAX</span></a>
                </div>
              </div>

            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="section stay-connected-section" aria-labelledby="stay-connected-title">
      <div class="container">
        <div class="stay-connected">
          <div class="stay-connected-copy">
            <h2 id="stay-connected-title" class="stay-title">Останемся на связи</h2>
            <p class="stay-copy">Афиши, новые видео и новости — подписывайтесь в Telegram и Instagram.</p>
          </div>
          <div class="stay-links">
            <a href={telegramChannelApp} data-social-destination data-social-web={telegramChannelWeb} data-social-platform="telegram" data-social-name="Telegram-канал с афишей"><BrandIcon name="telegram" size={22} /><span><strong>Telegram-канал</strong><small>Афиша и новости</small></span></a>
            <a href={instagram} data-social-destination data-social-web={instagram} data-social-platform="instagram" data-social-name="Instagram — подписаться"><BrandIcon name="instagram" size={22} /><span><strong>Instagram</strong><small>Подписаться</small></span></a>
            <a class="contact-save" href="/andrey-shevtsov.vcf" type="text/vcard"><Icon name="contact" size={22} /><span><strong>Сохранить контакт</strong><small>Добавить в телефон</small></span></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <dialog class="contact-sheet telegram-sheet" id="telegram-sheet" aria-labelledby="telegram-sheet-title" aria-describedby="telegram-sheet-description">
    <div class="sheet-handle" aria-hidden="true"></div>
    <div class="sheet-head">
      <div>
        <h3 id="telegram-sheet-title">Открыть соцсеть</h3>
        <p id="telegram-sheet-description">Выберите, как удобнее перейти.</p>
      </div>
      <button class="sheet-close" type="button" data-telegram-close aria-label="Закрыть"><Icon name="close" size={20} /></button>
    </div>
    <a class="telegram-open-app" id="telegram-open-app" href={telegramChannelApp} target="_blank" rel="noopener noreferrer">
      <span id="telegram-open-label">Открыть приложение Telegram</span><Icon name="arrow" size={18} />
    </a>
    <div class="telegram-qr-panel">
      <p class="telegram-qr-title">Откройте на телефоне по QR-коду</p>
      <div class="telegram-qr-frame">
        <canvas id="telegram-qr" width="194" height="194" role="img" aria-label="QR-код для открытия Telegram на телефоне"></canvas>
      </div>
      <p class="telegram-qr-hint" id="telegram-qr-hint">Наведите камеру телефона на QR-код.</p>
      <a class="telegram-mobile-url" id="telegram-mobile-url" href={telegramChannelWeb} target="_blank" rel="noopener noreferrer">Открыть веб-версию ↗</a>
    </div>
  </dialog>

  <ContactSheet />

  <footer class="footer">
    <div class="container">© {new Date().getFullYear()} Андрей Шевцов · singer.andreway.ru</div>
  </footer>
  <script>
    import QRCode from "qrcode";
    const socialDialog = document.getElementById('telegram-sheet');
    const socialTitle = document.getElementById('telegram-sheet-title');
    const socialDescription = document.getElementById('telegram-sheet-description');
    const socialOpen = document.getElementById('telegram-open-app');
    const socialOpenLabel = document.getElementById('telegram-open-label');
    const socialQr = document.getElementById('telegram-qr');
    const socialWeb = document.getElementById('telegram-mobile-url');
    const socialQrHint = document.getElementById('telegram-qr-hint');
    let lastSocialTrigger;

    function isMobileDevice() {
      if (navigator.userAgentData && typeof navigator.userAgentData.mobile === 'boolean') {
        return navigator.userAgentData.mobile;
      }
      const ua = navigator.userAgent || '';
      return /Android|iPhone|iPad|iPod|Mobile/i.test(ua)
        || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
    }

    // A locally drawn QR with rounded data modules and rounded finder eyes.
    // Keep the full 4-module quiet zone and high error correction for camera reliability.
    function drawRoundedQr(canvas, url, dark) {
      const qr = QRCode.create(url, { errorCorrectionLevel: 'M' });
      const size = qr.modules.size;
      const margin = 4;
      const pixels = 384;
      const unit = pixels / (size + margin * 2);
      canvas.width = pixels;
      canvas.height = pixels;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas unavailable');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, pixels, pixels);
      ctx.fillStyle = dark;

      function roundSquare(x, y, width, radius) {
        const r = Math.min(radius, width / 2);
        ctx.beginPath();
        ctx.roundRect(x, y, width, width, r);
        ctx.fill();
      }

      function inFinder(row, col) {
        return (row < 7 && col < 7)
          || (row < 7 && col >= size - 7)
          || (row >= size - 7 && col < 7);
      }

      const radius = unit * 0.28;
      for (let row = 0; row < size; row++) {
        for (let col = 0; col < size; col++) {
          if (inFinder(row, col) || !qr.modules.get(row, col)) continue;
          roundSquare((col + margin) * unit, (row + margin) * unit, unit, radius);
        }
      }

      // Draw the 3 positioning eyes with large rounded frames and crisp white gaps.
      [[0, 0], [size - 7, 0], [0, size - 7]].forEach(([col, row]) => {
        const x = (col + margin) * unit;
        const y = (row + margin) * unit;
        ctx.fillStyle = dark;
        roundSquare(x, y, unit * 7, unit * 1.7);
        ctx.fillStyle = '#ffffff';
        roundSquare(x + unit, y + unit, unit * 5, unit * 1.05);
        ctx.fillStyle = dark;
        roundSquare(x + unit * 2, y + unit * 2, unit * 3, unit * 0.75);
      });
    }

    document.querySelectorAll('a[data-social-destination]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (link.dataset.socialPlatform === 'telegram' || link.dataset.directMessenger === 'true') return; // Open installed apps via their direct links
        if (isMobileDevice() || !socialDialog || event.defaultPrevented) return;
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const webUrl = link.dataset.socialWeb;
        const destination = link.getAttribute('href');
        if (!webUrl || !destination) return;
        event.preventDefault();

        const platform = link.dataset.socialPlatform;
        const serviceNames = { whatsapp: 'WhatsApp', telegram: 'Telegram', max: 'MAX', instagram: 'Instagram' };
        const qrColors = { whatsapp: '#12683e', telegram: '#075778', max: '#244c81', instagram: '#642c86' };
        const service = serviceNames[platform] || 'соцсеть';
        lastSocialTrigger = link;
        socialTitle.textContent = 'Открыть ' + service;
        socialDescription.textContent = 'Откройте ссылку на компьютере или отсканируйте QR-код телефоном.';
        const hasAppLink = platform === 'telegram' || platform === 'whatsapp';
        socialOpen.href = platform === 'whatsapp'
          ? 'whatsapp://send?phone=79181142693' + (new URL(webUrl).searchParams.has('text')
            ? '&text=' + encodeURIComponent(new URL(webUrl).searchParams.get('text')) : '')
          : destination;
        socialOpenLabel.textContent = hasAppLink
          ? 'Открыть приложение ' + service + ' на компьютере'
          : 'Открыть ' + service + ' на компьютере';
        socialWeb.href = webUrl;
        socialWeb.textContent = 'Открыть ссылку в браузере ↗';
        socialQrHint.textContent = platform === 'max'
          ? 'Отсканируйте код камерой телефона с установленным MAX, чтобы открыть профиль.'
          : 'Отсканируйте код камерой телефона, чтобы открыть ' + service + '.';
        socialDialog.dataset.platform = platform;
        socialQr.setAttribute('aria-label', 'QR-код: ' + (link.dataset.socialName || service));
        try {
          drawRoundedQr(socialQr, webUrl, qrColors[platform] || '#075778');
        } catch (error) {
          console.error('QR-code generation failed', error);
          socialQr.getContext('2d')?.clearRect(0, 0, socialQr.width, socialQr.height);
          socialQr.setAttribute('aria-label', 'QR-код недоступен — используйте ссылку ниже');
          socialQrHint.textContent = 'Не удалось создать QR-код. Используйте ссылку в браузере ниже.';
        }
        const parentSheet = link.closest('#contact-sheet');
        if (parentSheet?.open) parentSheet.close();
        socialDialog.showModal();
        socialOpen.focus();
      });
    });

    document.querySelector('[data-telegram-close]')?.addEventListener('click', () => socialDialog?.close());
    socialDialog?.addEventListener('click', (event) => {
      if (event.target === socialDialog) socialDialog.close();
    });
    socialDialog?.addEventListener('close', () => lastSocialTrigger?.focus());
  </script>

  


