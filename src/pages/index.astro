      <a data-messenger="max" href={max} data-social-destination data-social-web={max} data-social-platform="max" data-social-name="написать в MAX" aria-label="Написать в MAX"><BrandIcon name="max" size={23} /><span>MAX</span></a>
      <a data-messenger="vk" href={vk} data-social-destination data-social-web={vk} data-social-platform="vk" data-social-name="написать ВКонтакте"><BrandIcon name="vk" size={23} /><span>ВКонтакте</span></a>
