  <script>
    import QRCode from "qrcode";
    const socialDialog = document.getElementById('telegram-sheet');
    const socialTitle = document.getElementById('telegram-sheet-title');
    const socialDescription = document.getElementById('telegram-sheet-description');
    const socialOpen = document.getElementById('telegram-open-app');
    const socialOpenLabel = document.getElementById('telegram-open-label');
    const socialQr = document.getElementById('telegram-qr');
    const socialWeb = document.getElementById('telegram-mobile-url');
    const socialQrHint = document.getElementById('telegram-qr-hint');
    let lastSocialTrigger;

    function isMobileDevice() {
      if (navigator.userAgentData && typeof navigator.userAgentData.mobile === 'boolean') {
        return navigator.userAgentData.mobile;
      }
      const ua = navigator.userAgent || '';
      return /Android|iPhone|iPad|iPod|Mobile/i.test(ua)
        || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
    }

    // A locally drawn QR with rounded data modules and rounded finder eyes.
    // Keep the full 4-module quiet zone and high error correction for camera reliability.
    function drawRoundedQr(canvas, url, dark) {
      const qr = QRCode.create(url, { errorCorrectionLevel: 'M' });
      const size = qr.modules.size;
      const margin = 4;
      const pixels = 384;
      const unit = pixels / (size + margin * 2);
      canvas.width = pixels;
      canvas.height = pixels;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas unavailable');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, pixels, pixels);
      ctx.fillStyle = dark;

      function roundSquare(x, y, width, radius) {
        const r = Math.min(radius, width / 2);
        ctx.beginPath();
        ctx.roundRect(x, y, width, width, r);
        ctx.fill();
      }

      function inFinder(row, col) {
        return (row < 7 && col < 7)
          || (row < 7 && col >= size - 7)
          || (row >= size - 7 && col < 7);
      }

      const radius = unit * 0.28;
      for (let row = 0; row < size; row++) {
        for (let col = 0; col < size; col++) {
          if (inFinder(row, col) || !qr.modules.get(row, col)) continue;
          roundSquare((col + margin) * unit, (row + margin) * unit, unit, radius);
        }
      }

      // Draw the 3 positioning eyes with large rounded frames and crisp white gaps.
      [[0, 0], [size - 7, 0], [0, size - 7]].forEach(([col, row]) => {
        const x = (col + margin) * unit;
        const y = (row + margin) * unit;
        ctx.fillStyle = dark;
        roundSquare(x, y, unit * 7, unit * 1.7);
        ctx.fillStyle = '#ffffff';
        roundSquare(x + unit, y + unit, unit * 5, unit * 1.05);
        ctx.fillStyle = dark;
        roundSquare(x + unit * 2, y + unit * 2, unit * 3, unit * 0.75);
      });
    }

    document.querySelectorAll('a[data-social-destination]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (isMobileDevice() || !socialDialog || event.defaultPrevented) return;
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const webUrl = link.dataset.socialWeb;
        const destination = link.getAttribute('href');
        if (!webUrl || !destination) return;
        event.preventDefault();

        const platform = link.dataset.socialPlatform;
        const serviceNames = { instagram: 'Instagram', whatsapp: 'WhatsApp',
          telegram: 'Telegram', max: 'MAX', vk: 'ВКонтакте' };
        const qrColors = { instagram: '#642c86', whatsapp: '#12683e',
          telegram: '#075778', max: '#244c81', vk: '#1863a9' };
        const service = serviceNames[platform] || 'соцсеть';
        lastSocialTrigger = link;
        socialTitle.textContent = 'Открыть ' + service;
        socialDescription.textContent = 'Откройте ссылку на компьютере или отсканируйте QR-код телефоном.';
        const hasAppLink = platform === 'telegram' || platform === 'whatsapp';
        socialOpen.href = platform === 'whatsapp'
          ? 'whatsapp://send?phone=79181142693' + (new URL(webUrl).searchParams.has('text')
            ? '&text=' + encodeURIComponent(new URL(webUrl).searchParams.get('text')) : '')
          : destination;
        socialOpenLabel.textContent = hasAppLink
          ? 'Открыть приложение ' + service + ' на компьютере'
          : 'Открыть ' + service + ' на компьютере';
        socialWeb.href = webUrl;
        socialWeb.textContent = 'Открыть ссылку в браузере ↗';
        socialQrHint.textContent = platform === 'max'
          ? 'Отсканируйте код камерой телефона с установленным MAX, чтобы открыть профиль.'
          : 'Отсканируйте код камерой телефона, чтобы открыть ' + service + '.';
        socialDialog.dataset.platform = platform;
        socialQr.setAttribute('aria-label', 'QR-код: ' + (link.dataset.socialName || service));
        try {
          drawRoundedQr(socialQr, webUrl, qrColors[platform] || '#075778');
        } catch (error) {
          console.error('QR-code generation failed', error);
          socialQr.getContext('2d')?.clearRect(0, 0, socialQr.width, socialQr.height);
          socialQr.setAttribute('aria-label', 'QR-код недоступен — используйте ссылку ниже');
          socialQrHint.textContent = 'Не удалось создать QR-код. Используйте ссылку в браузере ниже.';
        }
        const parentSheet = link.closest('#contact-sheet');
        if (parentSheet?.open) parentSheet.close();
        socialDialog.showModal();
        socialOpen.focus();
      });
    });

    document.querySelector('[data-telegram-close]')?.addEventListener('click', () => socialDialog?.close());
    socialDialog?.addEventListener('click', (event) => {
      if (event.target === socialDialog) socialDialog.close();
    });
    socialDialog?.addEventListener('close', () => lastSocialTrigger?.focus());
  </script>

  <script is:inline data-contact-sheet-script>
    const sheet = document.getElementById('contact-sheet');
    const sheetTitle = document.getElementById('sheet-title');
    const sheetCopy = document.getElementById('sheet-copy');
    const sheetRepertoire = document.getElementById('sheet-repertoire');
    let sheetTemplate = '';

    document.querySelectorAll('.js-contact-sheet').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        sheetTitle.textContent = trigger.dataset.title || 'Написать Андрею';
        sheetCopy.textContent = trigger.dataset.copy || 'Выберите удобный способ связи.';
        sheetTemplate = decodeURIComponent(trigger.dataset.template || '');
        sheetRepertoire.hidden = trigger.dataset.repertoire !== 'true';
        const waLink = sheet.querySelector('[data-messenger="whatsapp"]');
        if (waLink) {
          const url = 'https://wa.me/79181142693' + (sheetTemplate ? '?text=' + encodeURIComponent(sheetTemplate) : '');
          waLink.href = url;
          waLink.dataset.socialWeb = url;
        }
        sheet.showModal();
      });
    });

    sheet?.querySelector('.sheet-close')?.addEventListener('click', () => sheet.close());
    sheet?.addEventListener('click', (event) => {
      if (event.target === sheet) sheet.close();
    });

  </script>

  <script is:inline data-modal-scroll-lock>
    (() => {
      const dialogs = [...document.querySelectorAll('dialog')];
      let savedY = null;
      const sync = () => {
        const opened = dialogs.some(dialog => dialog.open);
        if (opened && savedY === null) {
          savedY = window.scrollY;
          document.body.style.position = 'fixed';
          document.body.style.top = '-' + savedY + 'px';
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
        } else if (!opened && savedY !== null) {
          const y = savedY;
          savedY = null;
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          window.scrollTo(0, y);
        }
      };
      dialogs.forEach(dialog => {
        dialog.addEventListener('toggle', sync);
        dialog.addEventListener('close', sync);
      });
    })();
  </script>
<script is:inline src="/js/next-show.js" defer></script>

</body>
</html>