<script is:inline data-home-reviews>
(()=>{
 const section=document.getElementById('reviews'),track=document.getElementById('reviews-track');
 const back=document.getElementById('reviews-back'),forward=document.getElementById('reviews-forward');
 const fallback=r=>r.avatarType==='female'?'/reviews/avatars/female.svg':r.avatarType==='male'?'/reviews/avatars/male.svg':'/reviews/placeholder-cat.svg';
 const append=(p,tag,cls,value)=>{const n=document.createElement(tag);n.className=cls||'';n.textContent=String(value||'');p.append(n);return n};
 const controls=()=>{const overflow=track.scrollWidth>track.clientWidth+2;document.getElementById('reviews-controls').hidden=!overflow;back.disabled=track.scrollLeft<2;forward.disabled=track.scrollLeft>=track.scrollWidth-track.clientWidth-2};
 window.singerReviewsLoaded=payload=>{
  const reviews=Array.isArray(payload?.reviews)?payload.reviews:[];if(!reviews.length){track.replaceChildren();section.hidden=true;return;}
  track.replaceChildren();
  for(const r of reviews.slice(0,10)){
   const card=document.createElement('article');card.className='home-review';
   const head=document.createElement('div');head.className='home-review-head';
   const img=document.createElement('img');img.width=54;img.height=54;img.loading='lazy';img.alt='Аватар гостя';
   const safe=typeof r.avatar==='string'&&r.avatar.startsWith('https://singer.andreway.ru/reviews/uploads/')?r.avatar:'';
   img.src=safe||fallback(r);img.onerror=()=>{const url=new URL(fallback(r),location.href).href;if(img.src!==url)img.src=url};
   const who=document.createElement('div');append(who,'strong','',r.author);append(who,'small','',[r.event,r.city,r.dateLabel].filter(Boolean).join(' · '));
   head.append(img,who);card.append(head);append(card,'p','',r.text);track.append(card);
  }
  section.hidden=false;requestAnimationFrame(()=>{controls();if(location.hash==='#reviews')section.scrollIntoView({block:'start',behavior:'smooth'});});
 };
 back.addEventListener('click',()=>track.scrollBy({left:-Math.max(260,track.clientWidth*.8),behavior:'smooth'}));
 forward.addEventListener('click',()=>track.scrollBy({left:Math.max(260,track.clientWidth*.8),behavior:'smooth'}));
 track.addEventListener('scroll',controls,{passive:true});window.addEventListener('resize',controls);
 // Show the last approved public snapshot immediately, then refresh from our own domain.
 const cacheKey='singer-public-reviews-v1';
 try{
  const cached=JSON.parse(localStorage.getItem(cacheKey)||'null');
  if(cached&&Date.now()-cached.savedAt<86400000&&Array.isArray(cached.data?.reviews))window.singerReviewsLoaded(cached.data);
 }catch{}
 fetch('/data/reviews.json',{cache:'no-cache'})
  .then(response=>{if(!response.ok)throw Error('reviews_unavailable');return response.json()})
  .then(data=>{
   if(!Array.isArray(data?.reviews))throw Error('invalid_reviews');
   window.singerReviewsLoaded(data);
   try{localStorage.setItem(cacheKey,JSON.stringify({savedAt:Date.now(),data}))}catch{}
  })
  .catch(()=>{});
})();
