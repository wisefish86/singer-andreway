---
import '../../styles/global.css';
import SiteFavicons from '../../components/SiteFavicons.astro';
import { reviews } from '../../data/reviews';
import { directChatLinks, contactMessages } from '../../config/contact-links';
const messageLinks = directChatLinks(contactMessages.feedback);
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<SiteFavicons/>
<title>Отзывы о выступлениях — Андрей Шевцов</title>
<meta name="description" content="Отзывы гостей о выступлениях певца Андрея Шевцова. Страница готовится к публикации первых отзывов."/>
<meta name="robots" content="noindex,follow"/>
<style is:global>
.reviews-main{max-width:1000px;margin:0 auto;padding:clamp(36px,6vw,72px) 20px 100px;min-height:75vh}
.reviews-eyebrow{color:var(--accent2);font-size:.78rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
.reviews-main h1{font-size:clamp(2.6rem,7vw,4.9rem);letter-spacing:-.047em;line-height:1.05;margin:14px 0 20px}
.reviews-intro{max-width:700px;line-height:1.7;color:var(--muted);font-size:clamp(1rem,2.4vw,1.14rem)}
.review-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,350px),1fr));gap:20px;margin:34px 0}
.review-card{border:1px solid var(--line);background:linear-gradient(145deg,var(--surface2),var(--surface));border-radius:23px;padding:clamp(22px,4vw,32px);min-width:0}
.review-badge{color:var(--accent2);font-size:.73rem;letter-spacing:.04em;font-weight:700}
.review-person{display:flex;align-items:center;gap:15px;margin:16px 0 25px}
.review-avatar{display:block;width:66px;height:66px;flex:0 0 66px;object-fit:cover;border-radius:50%;border:2px solid rgba(223,189,127,.35)}
.review-person strong{display:block;font-size:1.05rem;color:var(--text);margin-bottom:5px}
.review-person small{display:block;color:var(--muted);line-height:1.5}
.review-quote{font-size:1.09rem;line-height:1.75;color:var(--text);margin:0}
.review-note{margin-top:20px;border-top:1px solid var(--line);padding-top:15px;font-size:.82rem;color:var(--muted)}
.review-cta{background:rgba(219,177,104,.07);border:1px solid var(--line);border-radius:22px;padding:clamp(22px,4vw,36px)}
.review-cta h2{font-size:clamp(1.35rem,4vw,1.9rem);margin:0 0 10px}
.review-cta p{max-width:680px;color:var(--muted);line-height:1.65;margin:0 0 20px}
.review-actions{display:flex;flex-wrap:wrap;gap:10px}
.review-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:45px}
.review-dialog{box-sizing:border-box;width:min(90vw,470px);padding:26px;border-radius:20px;border:1px solid var(--line);background:#0b1b2a;color:var(--text)}
.review-dialog::backdrop{background:rgba(0,0,0,.72)}
.review-dialog h2{font-size:1.4rem;margin:0 0 10px}
.review-dialog p{color:var(--muted);line-height:1.6}
.review-dialog-links{display:grid;gap:12px;margin:18px 0}
.review-dialog-links a{min-height:48px;display:flex;align-items:center;justify-content:center}
.review-dialog .review-dialog-close{background:none;border:1px solid var(--line);color:var(--text);padding:9px 18px;border-radius:10px;font:inherit;cursor:pointer}
</style>
</head>
<body>
<header class="topbar"><div class="container topbar-inner"><a class="brand" href="/">ANDREY-SPOET</a><a class="media-back" href="/#live">← На главную</a></div></header>
<main class="reviews-main">
 <p class="reviews-eyebrow">Андрей Шевцов · живой вокал</p>
 <h1>Отзывы о выступлениях</h1>
 <p class="reviews-intro">Самое ценное после выступления — впечатления людей. Здесь будут появляться настоящие слова гостей с праздников, музыкальных вечеров и частных мероприятий.</p>
 <div class="review-grid" id="reviews-demo" aria-label="Пример карточки">
  {reviews.map(review=>(
   <article class="review-card">
    {review.demo && <span class="review-badge">ПРИМЕР ОФОРМЛЕНИЯ · НЕ НАСТОЯЩИЙ ОТЗЫВ</span>}
    <div class="review-person">
     <img src={review.avatar} alt="Иллюстрация кота — временная заглушка аватара" class="review-avatar" loading="lazy" width="66" height="66"/>
     <div><strong>{review.author}</strong><small>{review.event} · {review.city}</small><small>{review.dateLabel}</small></div>
    </div>
    <p class="review-quote">{review.text}</p>
    {review.demo && <p class="review-note">Карточка демонстрирует расположение аватара, имени, формата мероприятия, даты и текста. После согласования здесь появится реальный отзыв.</p>}
   </article>
  ))}
 </div>
 <div class="review-grid" id="reviews-live" aria-label="Отзывы гостей" hidden></div>
 <section class="review-cta">
  <h2>Хотите поделиться впечатлениями?</h2>
  <p>Если вы были на моём выступлении, буду благодарен даже за пару слов. Можно написать в удобном мессенджере — ничего заполнять и регистрировать не нужно.</p>
  <div class="review-actions">
   <button id="review-open-dialog" class="btn primary" type="button">Оставить отзыв →</button>
  </div>
 </section>
</main>
<dialog class="review-dialog" id="review-dialog" aria-labelledby="review-dialog-title">
 <h2 id="review-dialog-title">Сказать пару слов</h2>
 <p>Выберите удобный мессенджер и отправьте впечатления текстом, голосовым сообщением или видео.</p>
 <div class="review-dialog-links">
  <a class="btn primary" href={messageLinks.whatsapp} target="_blank" rel="noopener noreferrer">Написать в WhatsApp ↗</a>
  <a class="btn" href={messageLinks.telegramWeb} target="_blank" rel="noopener noreferrer">Написать в Telegram ↗</a>
 </div>
 <form method="dialog"><button class="review-dialog-close" type="submit">Закрыть</button></form>
</dialog>
<footer class="footer"><div class="container">© {new Date().getFullYear()} Андрей Шевцов · <a href="/">На главную</a></div></footer>
<script is:inline>
(()=>{
 const live=document.getElementById('reviews-live');
 const demo=document.getElementById('reviews-demo');
 const placeholder='/reviews/avatars/';
 function addText(parent,tag,klass,value){
  const el=document.createElement(tag);if(klass)el.className=klass;el.textContent=value;parent.append(el);return el;
 }
 window.singerReviewsLoaded=payload=>{
  if(!Array.isArray(payload?.reviews)||!payload.reviews.length)return;
  live.replaceChildren();
  for(const review of payload.reviews){
   const card=document.createElement('article');card.className='review-card';
   const person=document.createElement('div');person.className='review-person';
   const avatar=document.createElement('img');avatar.className='review-avatar';avatar.width=66;avatar.height=66;
   avatar.loading='lazy';avatar.alt='Аватар автора отзыва';
   const fallback=placeholder+(review.avatarType==='female'?'female.svg':'male.svg');
   const safe=typeof review.avatar==='string'&&review.avatar.startsWith('https://singer.andreway.ru/reviews/uploads/')?review.avatar:'';
   avatar.src=safe||fallback;avatar.onerror=()=>{if(avatar.src!==new URL(fallback,location.origin).href)avatar.src=fallback;};
   const identity=document.createElement('div');
   addText(identity,'strong','',String(review.author||'Гость'));
   const details=[review.event,review.city].filter(Boolean).join(' · ');
   if(details)addText(identity,'small','',details);
   if(review.dateLabel)addText(identity,'small','',String(review.dateLabel));
   person.append(avatar,identity);card.append(person);
   addText(card,'p','review-quote',String(review.text||''));
   live.append(card);
  }
  demo.hidden=true;live.hidden=false;
 };
 const script=document.createElement('script');
 script.async=true;
 script.src='https://script.google.com/macros/s/AKfycbzCtHUBRaC3c_Tovx6We58tVElMRn1w6FUkcLCdNZAVhDyLnVj8hut-_gKTXgov086tlg/exec?kind=reviews&callback=singerReviewsLoaded';
 document.head.append(script);
})();
</script>
<script is:inline>
(()=>{
 const dialog=document.getElementById('review-dialog');
 document.getElementById('review-open-dialog')?.addEventListener('click',()=>dialog?.showModal());
 dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
})();
</script>
</body></html>