---
import '../../styles/global.css';
import SiteFavicons from '../../components/SiteFavicons.astro';
const endpoint = 'https://jjaunlbglskpddslwegp.supabase.co/functions/v1/singer-vote';
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<SiteFavicons />
<title>Голосование за хиты вечера — Андрей Шевцов</title>
<meta name="description" content="Выберите три любимые песни для финалов выступления Андрея Шевцова."/>
<meta name="robots" content="noindex,follow"/>
<style is:global>
.vote-main{width:min(100% - 32px,800px);margin:0 auto;padding:40px 0 125px;min-height:80vh}
.vote-hero{padding:12px 0 20px}
.vote-hero h1{font-size:clamp(34px,6vw,52px);line-height:1.12;letter-spacing:-.045em;margin:10px 0 16px}
.vote-hero p{color:var(--muted);line-height:1.65;max-width:670px}
.vote-status{font-size:.84rem;color:var(--accent2);font-weight:700}
.vote-card{border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,#122232,#0b1825);padding:clamp(18px,4vw,30px);margin:16px 0;overflow:hidden}
.vote-card h2{font-size:clamp(21px,4vw,25px);margin:0 0 12px}
.vote-search{display:block;width:100%;box-sizing:border-box;font:inherit;color:var(--text);border-radius:12px;padding:14px 16px;background:#081725;border:1px solid rgba(210,225,237,.23);margin:9px 0 16px;min-height:52px}
.vote-search:focus-visible{outline:2px solid var(--accent2);outline-offset:2px}
.vote-option{display:flex;gap:13px;align-items:center;box-sizing:border-box;width:100%;padding:14px 12px;border-radius:13px;border:1px solid rgba(198,215,230,.11);background:rgba(255,255,255,.025);color:var(--text);min-width:0;transition:border-color .15s,background .15s}
.vote-option:hover{border-color:rgba(232,196,120,.55);background:rgba(255,255,255,.045)}
.vote-option.is-selected{border-color:var(--accent2);background:rgba(224,182,99,.11)}
.vote-option .check{flex:0 0 24px;width:24px;height:24px;border:2px solid rgba(211,222,234,.63);border-radius:7px;display:grid;place-items:center;color:var(--accent2);font-weight:900}
.vote-option.is-selected .check{border-color:var(--accent2)}
.vote-option .vote-songtext{flex:1;min-width:0;display:block}
.vote-option strong{display:block;color:var(--text);font-size:1rem;line-height:1.35;font-weight:720;overflow-wrap:anywhere}
.vote-option small{display:block;color:var(--muted);margin-top:4px;font-size:.84rem;line-height:1.35}
.vote-option .vote-count[hidden]{display:none}
.vote-option{position:relative;flex-wrap:wrap}
.vote-progress{flex-basis:calc(100% - 35px);width:auto;height:5px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden;margin:0 0 1px 35px}
.vote-progress[hidden]{display:none}
.vote-progress-fill{height:100%;width:0;background:linear-gradient(90deg,#d7a955,#f0cc7f);border-radius:99px;transition:width .4s ease}
.vote-progress-text{font-size:.72rem;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.vote-option .vote-count{font-size:.76rem;color:var(--accent2);white-space:nowrap;font-variant-numeric:tabular-nums;font-weight:700}
.vote-track-list{display:grid;gap:8px}
.vote-select{appearance:none;background:none;border:0;color:inherit;text-align:left;display:flex;gap:12px;align-items:center;flex:1;min-width:0;cursor:pointer;font:inherit;padding:0;min-height:42px}
.vote-select:focus-visible,.vote-preview:focus-visible{outline:2px solid var(--accent2);outline-offset:3px;border-radius:6px}
.vote-preview{flex:0 0 40px;width:40px;height:40px;display:grid;place-items:center;border-radius:50%;border:1px solid rgba(230,185,105,.55);background:rgba(230,185,105,.08);color:var(--accent2);font-size:20px;cursor:pointer}
.vote-preview[aria-pressed="true"]{background:var(--accent2);color:#081522}
.vote-preview[disabled]{opacity:.22;cursor:not-allowed}
.vote-tally{display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--muted);font-size:.86rem;margin:20px 0 10px;flex-wrap:wrap}
.vote-tally strong{color:var(--accent2);font-variant-numeric:tabular-nums}
.vote-leaders{color:var(--muted);font-size:.84rem;margin-bottom:14px}
.vote-actions{position:fixed;left:50%;bottom:max(12px,env(safe-area-inset-bottom));transform:translateX(-50%);width:min(calc(100% - 24px),760px);box-sizing:border-box;padding:12px 14px;border:1px solid rgba(232,193,113,.42);border-radius:17px;background:rgba(12,27,40,.97);box-shadow:0 12px 35px #0009;backdrop-filter:blur(16px);z-index:20}.vote-actions[hidden]{display:none!important}.vote-choice-hint{font-size:.82rem;text-align:center;color:var(--muted);margin:0 0 9px}.vote-choice-hint strong{color:var(--accent2)}.vote-actions .vote-alert{margin:0 0 10px;padding:9px 11px;font-size:.83rem}body:has(.vote-player:not([hidden])) .vote-actions{bottom:82px}
.vote-actions .btn{width:100%;justify-content:center;min-height:54px;border-radius:13px;font-weight:800}
.vote-actions .btn:disabled{opacity:.56;cursor:not-allowed}
.vote-meta{color:var(--muted);font-size:.84rem;line-height:1.55;margin:9px 0}
.vote-test-note{padding:12px 16px;border:1px solid rgba(255,195,85,.6);background:rgba(255,195,85,.1);color:var(--text);border-radius:12px;margin:12px 0;font-size:.9rem}
.vote-alert{padding:16px 18px;border-radius:12px;background:rgba(220,176,94,.1);border:1px solid rgba(220,176,94,.24);line-height:1.55;margin:12px 0}
.vote-price{font-size:24px;font-weight:800;color:var(--accent2)}
.vote-hidden{display:none!important}
.vote-player{position:fixed;z-index:30;bottom:0;left:0;right:0;display:flex;align-items:center;gap:12px;padding:11px max(16px,calc((100vw - 760px)/2));background:rgba(8,20,31,.97);backdrop-filter:blur(15px);border-top:1px solid rgba(232,193,113,.42);box-shadow:0 -12px 30px #0005}
.vote-player[hidden]{display:none!important}
.vote-player button{background:var(--accent2);color:#071521;border:0;border-radius:50%;width:42px;height:42px;flex:0 0 42px;font-size:18px;cursor:pointer;display:grid;place-items:center;padding:0;line-height:1}.vote-player button svg{display:block;flex:none}
.vote-player-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.9rem;font-weight:700}
.vote-player input{width:min(26vw,210px);accent-color:var(--accent2)}
.vote-player .vote-player-close{background:transparent;color:var(--text);border:1px solid var(--line)}
@media(max-width:550px){.vote-option{gap:9px;padding:12px 10px}.vote-preview{width:36px;height:36px;flex-basis:36px}.vote-option strong{font-size:.93rem}.vote-option .vote-count{font-size:.7rem}.vote-player input{width:75px}}
</style>
</head>
<body>
<header class="topbar"><div class="container topbar-inner"><a class="brand" href="/">ANDREY-SPOET</a><a class="media-back" href="/#live">← Для гостей</a></div></header>
<main class="vote-main">
 <header class="vote-hero">
  <span class="vote-status" id="vote-status">Подборка финальных песен</span>
  <h1>🔥 Выбираем хиты вечера!</h1>
  <p>Выберите от одной до трёх песен, которые хотите услышать в финалах музыкальных блоков. Главный фаворит завершит вечер!</p>
 </header>
 <div id="vote-test-note" class="vote-test-note" hidden>Тестовый режим: каждое нажатие «Отправить» добавляет пробные голоса. После отключения режима они не попадут в настоящее голосование.</div>
 <div id="vote-disabled" class="vote-alert" hidden role="status">Голосование сейчас не проводится. Вы по-прежнему можете посмотреть репертуар и заказать песню.</div>
  <div id="vote-closed" class="vote-alert" hidden role="status">
  Голосование пока закрыто. Список финальных песен можно посмотреть и выбрать до трёх любимых уже сейчас, а отправить голоса — во время выступления.
 </div>
 <section id="vote-open" class="vote-card" hidden>
  <h2>Ваши любимые песни</h2>
  <p class="vote-meta">Специальная подборка финальных хитов, а не весь репертуар. Выберите от одной до трёх песен: голоса принимаются только во время активного выступления.</p>
  <label for="vote-search" class="vote-meta">Найти песню или исполнителя</label>
  <input id="vote-search" class="vote-search" type="search" placeholder="Название или исполнитель" autocomplete="off"/>
  <p id="vote-voters" class="vote-leaders" aria-live="polite">Результаты голосования обновляются автоматически.</p>
  <div id="vote-songs" class="vote-track-list" aria-label="Песни для голосования"></div>


  <p id="vote-deadline" class="vote-meta"></p>
 </section>
 <section class="vote-card">
  <h2>🎤 Хотите услышать другую песню?</h2>
  <p>Выберите любую песню из моего репертуара и закажите её исполнение во время вечера.</p>
  <p><span class="vote-price">1 000 ₽</span> за песню · исполнение согласовывается с артистом</p>
  <a class="btn" href="/podborka/">Посмотреть репертуар и заказать песню →</a>
 </section>

</main>
<div class="vote-actions" id="vote-actions" hidden role="region" aria-label="Отправка выбранных песен"><p id="vote-choice-hint" class="vote-choice-hint" aria-live="polite"></p><div id="vote-message" class="vote-alert vote-hidden" role="status" aria-live="polite"></div><button id="vote-send" class="btn primary" disabled type="button">Отправить голос</button></div>
<div class="vote-player" id="vote-player" hidden role="region" aria-label="Прослушивание песни">
 <button id="vote-player-play" type="button" aria-label="Пауза"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M9 5v14M15 5v14"/></svg></button>
 <div class="vote-player-name" id="vote-player-name">Прослушивание</div>
 <input id="vote-player-seek" type="range" min="0" max="100" value="0" aria-label="Перемотать песню"/>
 <button class="vote-player-close" id="vote-player-close" type="button" aria-label="Закрыть проигрыватель">×</button>
 <audio id="vote-audio" preload="none"></audio>
</div>
<footer class="footer"><div class="container">© {new Date().getFullYear()} Андрей Шевцов · <a href="/">На главную</a></div></footer>
<script define:vars={{endpoint}}>
(()=>{
 const $=id=>document.getElementById(id);
 if(new URLSearchParams(location.search).has('manage')){
  location.replace('/vote/manage/');
  return;
 }
 const storageKey='singer-vote-guest-v1';
 let state=null,selected=new Set(),songs=[],saved=false,editing=false,sending=false,refreshBusy=false,statusBusy=false,statusKnown=false,votingAvailable=true;
 let testSubmissions=0;
 const PENDING_VOTE_KEY='singer-vote-pending-v1';
 let pendingVote=null;
 const STATUS_CACHE_KEY='singer-vote-live-snapshot-v1';
 const CATALOGUE_CACHE_KEY='singer-voting-finalists-v2';
 const cacheSongs=list=>{
  try{localStorage.setItem(CATALOGUE_CACHE_KEY,JSON.stringify({at:Date.now(),songs:list.map(({id,name,artist,preview_url})=>({id,name,artist,preview_url}))}));}catch{}
 };
 const usePreview=list=>{
  if(!Array.isArray(list)||list.length<3)return;
  songs=list.map(song=>({...song,votes:0}));
  state={...state,songs,voters:Number(state?.voters)||0};
  $('vote-open').hidden=!votingAvailable;$('vote-closed').hidden=!votingAvailable||!statusKnown||Boolean(state?.active);
  if(!statusKnown)$('vote-status').textContent='Выберите любимые песни · приём голосов уточняется';
  $('vote-voters').textContent='Доступно '+songs.length+' песен для выбора';
  render();
 };
 async function loadPublicCatalogue(){
  if(songs.length>=3)return;
  try{
   const response=await fetch('/data/repertoire.public.json',{cache:'force-cache'});
   if(!response.ok)throw Error('catalogue unavailable');
   const catalogue=await response.json();
   const candidates=(catalogue.songs||[]).filter(song=>Array.isArray(song.playlist_variants)&&
    song.playlist_variants.some(v=>String(v.relative_path||v.filename||'').includes('@')||String(v.title||'').includes('@'))||
    String(song.name||'').includes('@')).map(song=>({
     id:song.id,name:String(song.name||'').replace(/@/g,'').trim(),
     artist:String(song.artist||''),preview_url:String(song.preview_url||'')
    })).sort((a,b)=>(a.artist+' '+a.name).localeCompare(b.artist+' '+b.name,'ru'));
   cacheSongs(candidates);if(songs.length<3)usePreview(candidates);
  }catch{}
 }
 
 function setMessage(text){$('vote-message').textContent=text;$('vote-message').classList.remove('vote-hidden')}
 function clearMessage(){$('vote-message').classList.add('vote-hidden')}
 function voterId(){
  try{
   let id=localStorage.getItem(storageKey);
   if(!id||!/^[a-f0-9-]{36}$/.test(id)){id=crypto.randomUUID();localStorage.setItem(storageKey,id)}
   return id;
  }catch{return null}
 }
 async function api(body,key){
  const response=await fetch(endpoint,{method:body?'POST':'GET',cache:'no-store',signal:AbortSignal.timeout(body?12000:8000),
   // Vote POST uses a CORS-simple content type to avoid an extra preflight round trip.
   // Authenticated admin requests still use JSON and the Authorization header.
   headers:body?{'content-type':key?'application/json':'text/plain;charset=UTF-8',...(key?{authorization:'Bearer '+key}:{})}:{},
   ...(body?{body:JSON.stringify(body)}:{})});
  const result=await response.json();
  if(!response.ok)throw new Error(result.error||'Сервис временно недоступен');
  return result;
 }
 function updateButton(){
  const n=selected.size,active=votingAvailable&&Boolean(state?.active);
  $('vote-actions').hidden=n===0&&!pendingVote;
  const hint=n===1?'Можно выбрать ещё 2 песни':n===2?'Можно выбрать ещё 1 песню':n===3?'Вы выбрали все 3 песни':'';
  $('vote-choice-hint').textContent=active?hint:hint+(statusKnown?' · Голосование пока закрыто':' · Проверяем голосование…');
  $('vote-send').disabled=!votingAvailable||sending||(!pendingVote&&(n<1||n>3||songs.length<1||!active));
  $('vote-send').textContent=sending?'Проверяем отправку…':pendingVote?'Проверить отправку':!active?(statusKnown?'Голосование пока закрыто':'Проверяем голосование…'):state?.test_mode?'Отправить пробный голос':saved&&!editing?'Изменить голос':saved&&editing?'Сохранить изменения':'Отправить голос';
 }
 // Lightweight status endpoint: do not wait for catalogue or Google services.
 async function checkStatus(){
  if(statusBusy||sending||document.hidden)return;
  statusBusy=true;
  try{
   const response=await fetch(endpoint+'?status=1',{cache:'no-store',signal:AbortSignal.timeout(6500)});
   if(!response.ok)throw Error('status_unavailable');
   const next=await response.json();
   if(typeof next.active!=='boolean')throw Error('invalid_status');
    votingAvailable=next.available===true;
    $('vote-disabled').hidden=votingAvailable;
    if(!votingAvailable){
      state={active:false,available:false,songs:[],session:null};
      statusKnown=true;window.__voteSessionId=null;
      $('vote-open').hidden=true;$('vote-closed').hidden=true;
      $('vote-test-note').hidden=true;$('vote-actions').hidden=true;
      $('vote-status').textContent='Голосование отключено';
      stopAudio();return;
    }
   const oldId=state?.session?.id||null,nextId=next.active?next.session?.id:null;
   if(next.active&&!nextId)throw Error('invalid_session');
   if(state?.active&&oldId!==nextId&&refreshBusy)return;
   if(nextId!==oldId&&oldId!==null){selected.clear();saved=false;editing=false;if(pendingVote&&pendingVote.session_id!==nextId)clearPending();clearMessage()}
   state={...state,active:next.active,test_mode:Boolean(next.test_mode),session:next.session||null};
   statusKnown=true;window.__voteSessionId=nextId;
   if(nextId&&!state.test_mode&&!saved)try{
    const ids=JSON.parse(localStorage.getItem('singer-vote-choice:'+nextId)||'[]');
    if(Array.isArray(ids)&&ids.length>=1&&ids.length<=3&&new Set(ids).size===ids.length){
     selected=new Set(ids);saved=true;
    }
   }catch{}
   $('vote-closed').hidden=next.active;
   $('vote-test-note').hidden=!(next.active&&next.test_mode);
   $('vote-status').textContent=next.active?(next.test_mode?'● Тестовое голосование — голоса пробные':'● Голосование открыто'):'Голосование пока закрыто';
   $('vote-deadline').textContent=next.active?'Приём голосов до '+new Date(next.session.ends_at).toLocaleString('ru-RU',{timeZone:'Europe/Moscow',day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'})+' (МСК)':'';
   render();
  }catch{
   if(!statusKnown)$('vote-status').textContent='Выберите любимые песни · ждём подтверждения приёма голосов';
  }finally{statusBusy=false}
 }
 const voteLabel=(song,total)=>{
  const votes=Math.max(0,Number(song.votes)||0);
  if(!votes)return '';
  if(total<5)return votes+' '+(votes===1?'голос':votes<5?'голоса':'голосов');
  return Math.min(100,Math.round(votes/total*100))+'% ('+votes+')';
 };
 const audio=$('vote-audio');
 let playingId=null;
 const previewUrl=song=>{
  try{
   const u=new URL(song.preview_url);
   return u.protocol==='https:'&&u.hostname==='singer.andreway.ru'&&u.pathname.startsWith('/audio/plus/')&&!u.search&&!u.hash?u.href:'';
  }catch{return ''}
 };
 const PLAY_ICON="<svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m8 5 11 7-11 7V5Z\" fill=\"currentColor\" stroke=\"none\"/></svg>",PAUSE_ICON="<svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M9 5v14M15 5v14\"/></svg>";
 const synchronizeAudio=()=>{
  const playing=!audio.paused&&!audio.ended;
  $('vote-player-play').innerHTML=playing?PAUSE_ICON:PLAY_ICON;
  $('vote-player-play').setAttribute('aria-label',playing?'Пауза':'Воспроизвести');
  for(const btn of document.querySelectorAll('.vote-preview')){
   const isCurrent=btn.dataset.songId===playingId&&playing;
   btn.innerHTML=isCurrent?PAUSE_ICON:PLAY_ICON;
   btn.setAttribute('aria-pressed',String(isCurrent));
   btn.setAttribute('aria-label',(isCurrent?'Пауза: ':'Прослушать: ')+btn.dataset.songName);
  }
 };
 const stopAudio=()=>{
  audio.pause();audio.removeAttribute('src');audio.load();playingId=null;
  $('vote-player').hidden=true;synchronizeAudio();
 };
 const playPreview=async song=>{
  const url=previewUrl(song);if(!url)return;
  if(playingId===song.id){if(audio.paused)await audio.play().catch(()=>{});else audio.pause();synchronizeAudio();return;}
  audio.pause();audio.src=url;playingId=song.id;
  $('vote-player-name').textContent=song.artist+' — '+song.name;
  $('vote-player').hidden=false;
  $('vote-player-seek').value=0;
  await audio.play().catch(()=>{});
  synchronizeAudio();
 };
 $('vote-player-close').addEventListener('click',stopAudio);
 $('vote-player-play').addEventListener('click',()=>{if(audio.paused)audio.play().catch(()=>{});else audio.pause();synchronizeAudio()});
 $('vote-player-seek').addEventListener('input',event=>{if(Number.isFinite(audio.duration)&&audio.duration>0)audio.currentTime=Number(event.target.value)/100*audio.duration});
 audio.addEventListener('timeupdate',()=>{if(Number.isFinite(audio.duration)&&audio.duration>0)$('vote-player-seek').value=audio.currentTime/audio.duration*100});
 audio.addEventListener('play',synchronizeAudio);audio.addEventListener('pause',synchronizeAudio);audio.addEventListener('ended',synchronizeAudio);
 audio.addEventListener('error',()=>setMessage('Не удалось воспроизвести аудио. Попробуйте другую песню.'));

 function render(){
  const query=$('vote-search').value.trim().toLocaleLowerCase('ru');
  $('vote-songs').replaceChildren();
  for(const song of songs){
   if(!(song.name+' '+song.artist).toLocaleLowerCase('ru').includes(query))continue;
   const row=document.createElement('div');row.className='vote-option'+(selected.has(song.id)?' is-selected':'');row.dataset.voteId=song.id;
   const selector=document.createElement('button');selector.type='button';selector.className='vote-select';
   selector.setAttribute('aria-pressed',String(selected.has(song.id)));
   selector.setAttribute('aria-label',(selected.has(song.id)?'Убрать: ':'Выбрать: ')+song.artist+' — '+song.name);
   const mark=document.createElement('span');mark.className='check';mark.setAttribute('aria-hidden','true');mark.textContent=selected.has(song.id)?'✓':'';
   const info=document.createElement('span');
   const name=document.createElement('strong');
   const artist=document.createElement('small');
   info.className='vote-songtext';
   name.textContent=song.name;artist.textContent=song.artist;info.append(name,artist);selector.append(mark,info);
   selector.addEventListener('click',()=>{
    if(saved&&!editing&&!state?.test_mode){setMessage('Чтобы поменять песни, нажмите «Изменить голос» внизу страницы.');return}
    if(selected.has(song.id))selected.delete(song.id);
    else if(selected.size<3)selected.add(song.id);
    else{setMessage('Можно выбрать только три песни. Снимите один из предыдущих выборов.');return}
    clearMessage();updateButton();render();
   });
   row.append(selector);
   const votes=document.createElement('span');votes.className='vote-count';
   votes.hidden=!state?.active||!(Number(song.votes)>0);
   const total=Math.max(0,Number(state?.voters)||0);
   const percent=total>0?Math.min(100,Math.round((Number(song.votes)||0)/total*100)):0;
   votes.textContent=voteLabel(song,total);row.append(votes);
   const listen=document.createElement('button');listen.type='button';listen.className='vote-preview';
   listen.dataset.songId=song.id;listen.dataset.songName=song.name;listen.innerHTML=PLAY_ICON;
   const hasPreview=Boolean(previewUrl(song));listen.disabled=!hasPreview;
   listen.setAttribute('aria-label',hasPreview?'Прослушать: '+song.name:'Аудиофрагмент недоступен: '+song.name);
   listen.setAttribute('aria-pressed','false');
   listen.addEventListener('click',()=>playPreview(song));row.append(listen);
   const bar=document.createElement('div');bar.className='vote-progress';bar.hidden=!state?.active||!(Number(song.votes)>0);
   const fill=document.createElement('div');fill.className='vote-progress-fill';
   fill.style.width=percent+'%';bar.append(fill);
   row.append(bar);
   $('vote-songs').append(row);
  }
  synchronizeAudio();updateButton();
 }
 async function refresh(){
  if(refreshBusy||sending||document.hidden)return;
  refreshBusy=true;
  try{
   const result=await api();
   votingAvailable=result.available===true;
   $('vote-disabled').hidden=votingAvailable;
   if(!votingAvailable){
      state={active:false,available:false,songs:[],session:null};
      statusKnown=true;$('vote-open').hidden=true;$('vote-closed').hidden=true;
      $('vote-actions').hidden=true;$('vote-test-note').hidden=true;
      $('vote-status').textContent='Голосование отключено';
      stopAudio();return;
   }
   const active=Boolean(result.active);
   const incoming=Array.isArray(result.songs)?result.songs:[];
   const newId=active?result.session.id:null;
   const oldId=window.__voteSessionId||null;
   const changedSession=newId!==null&&newId!==oldId;
   if(changedSession){
    if(oldId!==null){selected.clear();saved=false;editing=false;if(pendingVote&&pendingVote.session_id!==newId)clearPending();}
    if(!result.test_mode){
     try{
      const ids=JSON.parse(localStorage.getItem('singer-vote-choice:'+newId)||'[]');
      if(Array.isArray(ids)&&ids.length>=1&&ids.length<=3&&new Set(ids).size===ids.length){
       for(const id of ids)selected.add(id);
       saved=true;
      }
     }catch{}
    }
   }
   window.__voteSessionId=newId;
   state=result;statusKnown=true;
   try{localStorage.setItem(STATUS_CACHE_KEY,JSON.stringify({at:Date.now(),value:result}));}catch{}
   cacheSongs(incoming);
   $('vote-open').hidden=!votingAvailable;
   $('vote-closed').hidden=active||!votingAvailable;
   $('vote-test-note').hidden=!(active&&result.test_mode);
   $('vote-status').textContent=active?(result.test_mode?'● Тестовое голосование — голоса пробные':'● Голосование открыто'):'Голосование пока закрыто';
   const incomingMap=new Map(incoming.map(song=>[song.id,song]));
   const sameOrder=songs.length===incoming.length&&songs.every(song=>incomingMap.has(song.id));
   // Don't reorder while someone is actively choosing songs.
   songs=!changedSession&&selected.size>0&&!saved&&sameOrder?songs.map(song=>incomingMap.get(song.id)):incoming;
   const DOMids=[...$('vote-songs').children].map(node=>node.dataset.voteId);
   const search=$('vote-search').value.trim().toLocaleLowerCase('ru');
   const orderedIds=songs.filter(song=>(song.name+' '+song.artist).toLocaleLowerCase('ru').includes(search)).map(song=>song.id);
   if(changedSession||orderedIds.join('|')!==DOMids.join('|'))render();
   else for(const song of songs){
    const item=[...$('vote-songs').children].find(node=>node.dataset.voteId===song.id);
    if(item){const count=item.querySelector('.vote-count');if(count){count.hidden=!active||!(Number(song.votes)>0);}
     const bar=item.querySelector('.vote-progress'),fill=item.querySelector('.vote-progress-fill');
     const total=Number(result.voters)||0;
     const percent=total>0?Math.min(100,Math.round((Number(song.votes)||0)/total*100)):0;
     if(bar)bar.hidden=!active||!(Number(song.votes)>0);if(fill)fill.style.width=percent+'%';if(count)count.textContent=voteLabel(song,total);}
   }
   $('vote-voters').textContent=incoming.length<3?'Список финальных песен пока недоступен.':
    active?(Number(result.voters)>0?'Песни с большинством голосов — сверху.':'Пока нет голосов — станьте первым!'):
     'Всего '+incoming.length+' финальных песен · Результаты появятся после начала голосования.';
   $('vote-deadline').textContent=active?'Приём голосов до '+new Date(result.session.ends_at).toLocaleString('ru-RU',{timeZone:'Europe/Moscow',day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'})+' (МСК)':'';
   updateButton();
  }catch(e){
   $('vote-voters').textContent=state?.active?'Результаты обновляются с задержкой. Голосование доступно.':'Свежие результаты пока недоступны.';
   if(!statusKnown)$('vote-status').textContent='Выберите любимые песни · приём голосов уточняется';
   if(songs.length<3)await loadPublicCatalogue();
   updateButton();
  }finally{refreshBusy=false}
 }
 $('vote-search').addEventListener('input',render);
 // Stable request ID makes test-mode retries safe: one request equals one ballot.
 function rememberPending(payload){
  pendingVote=payload;
  try{localStorage.setItem(PENDING_VOTE_KEY,JSON.stringify(payload))}catch{}
 }
 function clearPending(){
  pendingVote=null;
  try{localStorage.removeItem(PENDING_VOTE_KEY)}catch{}
 }
 async function sendPendingVote(){
  if(sending||!pendingVote)return;
  const payload=pendingVote;
  if(!state?.active||state.session?.id!==payload.session_id){
   setMessage('Сессия голосования закрыта или изменилась. Отправить прежний голос нельзя.');
   return;
  }
  sending=true;
  setMessage('Отправляем ваш голос… Не закрывайте страницу до подтверждения.');
  updateButton();
  try{
   let acknowledged=false;
   for(let attempt=0;attempt<3;attempt++){
    if(attempt>0)setMessage('Связь задерживается. Повторно проверяем получение голоса… Пока не закрывайте страницу.');
    try{
     const response=await fetch(endpoint,{method:'POST',cache:'no-store',
      headers:{'content-type':'text/plain;charset=UTF-8'},signal:AbortSignal.timeout(5500),
      body:JSON.stringify(payload)});
     const result=await response.json();
     if(!response.ok)throw new Error(result.error||'server_unavailable');
     if(result.ok!==true)throw new Error('server_unavailable');
     acknowledged=true;break;
    }catch(err){
     if(!['TimeoutError','AbortError','TypeError'].includes(err.name))throw err;
     if(attempt===2)throw err;
    }
   }
   if(!acknowledged)throw new Error('not_confirmed');
   const choices=payload.song_ids,isTest=Boolean(state.test_mode),sessionId=payload.session_id;
   clearPending();saved=true;editing=false;
   if(!isTest)try{localStorage.setItem('singer-vote-choice:'+sessionId,JSON.stringify(choices))}catch{}
   if(isTest){
    testSubmissions++;
    state.voters=(Number(state.voters)||0)+1;
    songs=songs.map(song=>({...song,votes:(Number(song.votes)||0)+(choices.includes(song.id)?1:0)}));
    render();
   }
   setMessage(isTest?'Пробный голос №'+testSubmissions+' принят! Можно закрыть страницу или проголосовать снова.':'Голос принят! Теперь можно закрыть страницу или изменить выбор.');
  }catch(err){
   const retryable=['TimeoutError','AbortError','TypeError'].includes(err?.name)||err?.message==='not_confirmed'||err?.message==='server_unavailable';
   if(!retryable)clearPending();
   setMessage(retryable?'Не удалось подтвердить получение голоса. Нажмите «Проверить отправку». При следующем открытии страницы попытку можно повторить без удвоения голоса.':'Голос отклонён сервером: '+(err?.message||'неизвестная ошибка'));
  }finally{sending=false;updateButton();refresh()}
 }
 $('vote-send').addEventListener('click',async()=>{
  if(sending)return;
  if(!state?.active){setMessage('Голосование пока закрыто. Попробуйте во время выступления.');return}
  if(pendingVote){await sendPendingVote();return}
  if(saved&&!editing&&!state.test_mode){editing=true;clearMessage();updateButton();return}
  const voter=voterId();
  if(!voter){setMessage('Браузер ограничивает хранение данных. Попробуйте открыть страницу в обычном браузере.');return}
  const choices=[...selected];
  if(choices.length<1||choices.length>3)return;
  rememberPending({action:'vote',session_id:state.session.id,voter_id:voter,
   song_ids:choices,request_id:crypto.randomUUID()});
  await sendPendingVote();
 });
 let restored=false;
 try{
  const snapshot=JSON.parse(localStorage.getItem(STATUS_CACHE_KEY)||'null');
  if(snapshot&&Date.now()-snapshot.at<60000&&snapshot.value?.session?.id&&Date.parse(snapshot.value.session.ends_at)>Date.now()&&Array.isArray(snapshot.value.songs)){
   state=snapshot.value;songs=state.songs;restored=true;statusKnown=true;
   window.__voteSessionId=state.session.id;
   if(!state.test_mode)try{
    const ids=JSON.parse(localStorage.getItem('singer-vote-choice:'+state.session.id)||'[]');
    if(Array.isArray(ids)&&ids.length<=3&&ids.length>0){selected=new Set(ids);saved=true}
   }catch{}
   $('vote-open').hidden=false;$('vote-closed').hidden=true;
   $('vote-test-note').hidden=!state.test_mode;
   $('vote-status').textContent=state.test_mode?'● Тестовое голосование — голоса пробные':'● Голосование открыто';
   $('vote-voters').textContent='Загружаем свежие результаты…';
   $('vote-deadline').textContent='Приём голосов до '+new Date(state.session.ends_at).toLocaleString('ru-RU',{timeZone:'Europe/Moscow',day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'})+' (МСК)';
   render();
  }
 }catch{}
 try{
  const old=JSON.parse(localStorage.getItem(PENDING_VOTE_KEY)||'null');
  if(old&&old.action==='vote'&&typeof old.request_id==='string'&&Array.isArray(old.song_ids)&&old.song_ids.length>=1&&old.song_ids.length<=3){
   pendingVote=old;
   setMessage('Есть голос без подтверждения. Нажмите «Проверить отправку», чтобы безопасно повторить попытку.');
  }
 }catch{}
 updateButton();
 if(!restored)try{
  const cached=JSON.parse(localStorage.getItem(CATALOGUE_CACHE_KEY)||'null');
  if(cached&&Date.now()-cached.at<7*86400000)usePreview(cached.songs);
 }catch{}
 // Start fast status first; do not compete with the heavier full tally request.
 // The public song catalogue remains independent, so visitors can choose while status resolves.
 loadPublicCatalogue();
 checkStatus().finally(()=>{if(!document.hidden)refresh()});
 setInterval(checkStatus,6000);
 setInterval(refresh,18000);
 document.addEventListener('visibilitychange',()=>{if(!document.hidden){checkStatus().finally(()=>refresh())}});
})();
</script>
</body></html>
